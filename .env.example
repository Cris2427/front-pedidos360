# Copia este archivo como .env y completa con los valores de TU tenant.
# El .env real NO se sube al repositorio (está en .gitignore): lleva los
# identificadores de tu organización.

# Registro de aplicación del FRONTEND (Pedidos360-Frontend)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Backend protegido: AWS API Gateway + JWT authorizer (Entra ID)
VITE_API_BASE_URL=https://<id-de-tu-api>.execute-api.us-east-1.amazonaws.com

# Los cinco scopes que expone la app de API (Pedidos360-API), separados por
# espacio. messaging.manage es el del administrador de la mensajería: solo
# administradores pueden consentirlo, así que hay que conceder el
# consentimiento de administrador antes de agregarlo aquí.
VITE_API_SCOPE=api://<id-de-tu-api>/orders.read api://<id-de-tu-api>/orders.write api://<id-de-tu-api>/catalog.read api://<id-de-tu-api>/catalog.write api://<id-de-tu-api>/messaging.manage
